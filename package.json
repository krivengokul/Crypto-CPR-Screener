    "typecheck": "npm run typecheck --workspace=@workspace/cpr-screener",
    "lint": "npm run typecheck --workspace=@workspace/cpr-screener"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.8.3",
    "ts-morph": "^23.0.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
